{
  "name": "moat-sandbox",
  "version": "0.1.0",
  "description": "Run Pi in a disposable Linux sandbox and review its changes hunk by hunk before applying them to your working tree.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "moat": "./dist/cmd/main.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "moat": "node cmd/main.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "coverage": "node --experimental-test-coverage --test test/unit/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "bash test/e2e-pi.sh",
    "test:extras": "bash test/e2e-extras.sh",
    "test:provider": "bash test/e2e-provider.sh",
    "test:demo": "bash test/e2e-demo.sh",
    "test:review": "bash test/e2e-review.sh",
    "test:live": "bash test/pi-live.sh",
    "prepublishOnly": "npm run typecheck && npm run test:unit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "stub",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "keywords": [
    "sandbox",
    "ai-agent",
    "coding-agent",
    "pi",
    "code-review",
    "isolation",
    "userns",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nochinsky/moat.git"
  },
  "author": "nochinsky",
  "homepage": "https://github.com/nochinsky/moat#readme",
  "bugs": {
    "url": "https://github.com/nochinsky/moat/issues"
  }
}
