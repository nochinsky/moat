{
  "name": "moat-sandbox",
  "version": "0.0.3",
  "description": "Run an AI coding agent in a disposable Linux sandbox, and review what it did hunk by hunk before any of it reaches your machine.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "moat": "./dist/cmd/main.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "moat": "node cmd/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "coverage": "node --experimental-test-coverage --test test/unit/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "bash test/e2e-codex.sh",
    "test:extras": "bash test/e2e-extras.sh",
    "test:provider": "bash test/e2e-provider.sh",
    "test:demo": "bash test/e2e-demo.sh",
    "test:review": "bash test/e2e-review.sh",
    "prepublishOnly": "npm run typecheck && npm run test:unit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "stub",
    "docs",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "keywords": [
    "sandbox",
    "ai-agent",
    "coding-agent",
    "codex",
    "code-review",
    "isolation",
    "userns",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nochinsky/moat.git"
  },
  "author": "nochinsky",
  "homepage": "https://github.com/nochinsky/moat#readme",
  "bugs": {
    "url": "https://github.com/nochinsky/moat/issues"
  }
}
