{
  "name": "moat",
  "version": "0.0.1",
  "private": true,
  "description": "Run an AI coding agent inside a disposable, fully isolated Linux sandbox. The host is never touched.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "moat": "./cmd/main.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "moat": "node cmd/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "coverage": "node --experimental-test-coverage --test test/unit/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:e2e": "bash test/e2e-codex.sh",
    "test:extras": "bash test/e2e-extras.sh",
    "test:provider": "bash test/e2e-provider.sh",
    "test:demo": "bash test/e2e-demo.sh",
    "test:review": "bash test/e2e-review.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2"
  },
  "files": [
    "cmd",
    "lib",
    "sandbox",
    "sync",
    "secrets",
    "bundle",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "sandbox",
    "agent",
    "coding-agent",
    "isolation",
    "codex",
    "ai",
    "containers",
    "userns"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nochinsky/moat.git"
  },
  "author": "nochinsky",
  "homepage": "https://github.com/nochinsky/moat#readme",
  "bugs": {
    "url": "https://github.com/nochinsky/moat/issues"
  }
}
